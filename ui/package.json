{
  "name": "mmx-node-web-gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "mkdir -p dist && rm -rf dist/* || true",
    "lint": "bunx eslint ./src ./src-bex --fix",
    "format": "bunx prettier --write \"**/*.{js,vue,scss,html,md,json}\" --list-different --ignore-path .gitignore --ignore-path .prettierignore",
    "dev": "bunx vite",
    "build": "bunx vite build",
    "preview": "bunx vite preview",
    "dev:explorer": "bunx vite --config vite.config.explorer.js",
    "build:explorer": "bunx vite build --config vite.config.explorer.js",
    "preview:explorer": "bunx vite preview --config vite.config.explorer.js",
    "dev:offline": "bunx vite --config vite.config.offline.js",
    "build:offline": "bunx vite build --config vite.config.offline.js",
    "preview:offline": "bunx vite preview --config vite.config.offline.js",
    "build:all": "bun run zip:wxt && bun run build:offline && bun run build && bun run build:explorer",
    "build:android": "bun run build:explorer && bunx cap sync && bunx capacitor-assets generate --android && bunx cap build android",
    "dev:wxt": "bunx wxt",
    "dev:wxt:firefox": "bunx wxt -b firefox",
    "build:wxt": "bunx wxt build",
    "build:wxt:firefox": "bunx wxt build -b firefox",
    "zip:wxt": "bunx wxt zip",
    "zip:wxt:firefox": "bunx wxt zip -b firefox",
    "postinstall": "bunx wxt prepare",
    "test": "bunx vitest"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@fontsource-variable/roboto-flex": "^5.2.8",
    "@fontsource-variable/roboto-mono": "^5.2.8",
    "@highlightjs/vue-plugin": "^2.1.0",
    "@mdi/js": "^7.4.47",
    "@metamask/browser-passworder": "^6.0.0",
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0",
    "@quasar/extras": "^1.17.0",
    "@scure/base": "^2.0.0",
    "@scure/bip39": "^2.0.1",
    "@tanstack/vue-query": "^5.92.12",
    "@tanstack/vue-query-devtools": "^6.1.5",
    "@vueuse/components": "^14.2.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "@wxt-dev/storage": "^1.2.8",
    "animate.css": "^4.1.1",
    "axios": "^1.13.6",
    "echarts": "^6.0.0",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "json-bigint": "^1.0.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "quasar": "^2.18.7",
    "vue": "^3.5.30",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.4",
    "webext-bridge": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.4",
    "@eslint/compat": "^2.0.3",
    "@quasar/vite-plugin": "^1.11.0",
    "@tanstack/eslint-plugin-query": "^5.91.5",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "bun": "1.3.11",
    "bunx": "^0.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-pinia": "^0.4.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.8.4",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.98.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-generate-file": "^0.3.1",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-singlefile": "^2.3.2",
    "vite-plugin-static-copy": "^3.3.0",
    "vite-plugin-vue-devtools": "^8.1.0",
    "vitest": "^4.1.0",
    "wxt": "0.20.20"
  },
  "overrides": {
    "web-ext-run": "0.2.3"
  }
}
